# Copy to .env and adjust. main.go loads plain environment variables; use a tool
# like `direnv`, `set -a; source .env`, or your process manager to export them.

HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:5173

DATABASE_URL=postgres://retriv:retriv@localhost:5432/retriv?sslmode=disable

# Ollama runs on the host (local), even in the full-docker workflow.
# In docker, the API reaches it via http://host.docker.internal:11434 (set in compose).
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:1b

# Real SMTP (Gmail). MAIL_PASSWORD must be a Google App Password, not your login
# password (requires 2FA). MAIL_FROM defaults to MAIL_USERNAME if left blank.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 32-byte key, base64-encoded. REGENERATE: openssl rand -base64 32
ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Session cookie signing secret. REGENERATE: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Tunables (defaults shown; all optional)
MATCH_RADIUS_METERS=5000
MATCH_TIME_WINDOW=336h
MATCH_MAX_COSINE_DISTANCE=0.35
MATCH_CANDIDATE_LIMIT=5
MIN_CONFIDENCE=0.7
MAX_VERIFY_ATTEMPTS=3
LOST_REPORTS_PER_DAY=2
REPORT_TTL=720h
